# NexusOS Core Local requires no provider, Cloudflare, GitHub, or SaaS secret.
# Keep these values empty unless you are developing an optional hosted profile.

# UTF-8 secret, minimum 32 bytes. Format: opaque string.
NEXUS_MESSAGE_INTEGRITY_KEY=

# Canonical one-line JSON keyring. Format:
# {"activeKeyId":"KEY_ID","keys":{"KEY_ID":"BASE64URL_32_BYTES"},"schemaVersion":1}
NEXUS_PROMPT_CIPHER_KEYS=

# Private hosted profile only. Format: exactly 1 when enabled.
NEXUS_PRIVATE_ALPHA_IDENTITY=

# Private hosted profile only. Format: one normalized email address.
NEXUS_PRIVATE_ALPHA_OWNER_EMAIL=

# Optional local tuning. Format: integer seconds.
NEXUS_PRESENCE_TTL_SECONDS=

# Optional local runner audience. Format: absolute http(s) URL.
NEXUS_RUNNER_AUDIENCE=
